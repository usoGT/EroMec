{
  "name": "puanto",
  "productName": "Puanto",
  "version": "2.0.0",
  "description": "Puanto - personel, puantaj, mesai, bordro ve gider takibi",
  "author": "Puanto",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && vite build && node scripts/build-main.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "electron .",
    "dev:web": "vite --mode web",
    "build:web": "vite build --mode web",
    "preview:web": "vite preview --mode web",
    "mobile:sync": "npm run build:web && cap sync",
    "mobile:assets": "node scripts/make-mobile-assets.mjs && capacitor-assets generate --android --ios --iconBackgroundColor \"#0a0a0a\" --iconBackgroundColorDark \"#0a0a0a\" --splashBackgroundColor \"#0d0d0d\" --splashBackgroundColorDark \"#0d0d0d\"",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:win:portable": "npm run build && electron-builder --win portable --x64 --publish never"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@supabase/supabase-js": "^2.119.0",
    "exceljs": "^4.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "sql.js": "^1.15.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.57.0",
    "postcss": "^8.5.30",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^3.4.19",
    "typescript": "5.9",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "build": {
    "appId": "app.puanto",
    "productName": "Puanto",
    "copyright": "Puanto",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!node_modules/sql.js/dist/*.zip",
      "!node_modules/sql.js/dist/*-debug*",
      "!node_modules/sql.js/dist/*-browser*",
      "!node_modules/sql.js/dist/sql-asm*",
      "!node_modules/sql.js/dist/worker.*",
      "!node_modules/sql.js/dist/sql-wasm-inline.js",
      "!node_modules/exceljs/dist"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Puanto-Kurulum-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Puanto",
      "uninstallDisplayName": "Puanto",
      "language": "1055",
      "installerLanguages": [
        "tr_TR"
      ],
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Puanto-Tasinabilir-${version}.${ext}"
    },
    "publish": null
  }
}
